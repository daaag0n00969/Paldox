<?xml version="1.0" encoding="utf-8"?>
<!--
  Baseline network posture. Paldox does not declare INTERNET and has no backends,
  but we still disable cleartext in case a future feature adds network access.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
